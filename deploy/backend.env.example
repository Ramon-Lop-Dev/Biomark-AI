NODE_ENV=production
PORT=3000
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ROTATE_AND_SET_SECRET
SUPABASE_ANON_KEY=SET_ANON_KEY_IF_NEEDED
# URL HTTPS del proxy del Pod de RunPod. No usar http://ai-service:8000.
AI_SERVICE_URL=https://POD_ID-8000.proxy.runpod.net
AI_SERVICE_INTERNAL_KEY=GENERATE_LONG_RANDOM_SECRET
CORS_ORIGINS=https://biomark-api.duckdns.org
N8N_WEBHOOK_URL=http://n8n:5678/webhook/biomark-events
N8N_WEBHOOK_SECRET=GENERATE_LONG_RANDOM_SECRET

# Firebase Admin SDK opcional: privado, solo backend. El envio programado de
# FCM del flujo actual lo realiza n8n con su credencial Google API.
FIREBASE_PROJECT_ID=biomark-ai-prod
FIREBASE_CLIENT_EMAIL=service-account@biomark-ai-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_REAL_PRIVATE_KEY\n-----END PRIVATE_KEY-----\n"
