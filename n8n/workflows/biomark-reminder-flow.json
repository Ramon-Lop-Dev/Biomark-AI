{
  "name": "Biomark reminder flow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "biomark-events",
        "responseMode": "ON_RECEIVED",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook: recordatorio.creado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        220
      ],
      "webhookId": "biomark-reminder-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.body.evento }}",
              "operation": "equal",
              "value2": "recordatorio.creado"
            }
          ]
        },
        "options": {}
      },
      "id": "filter-event",
      "name": "Filtrar evento",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        520,
        220
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "recordatorioId",
              "name": "recordatorioId",
              "value": "={{ $json.body.recordatorio.id }}",
              "type": "string"
            },
            {
              "id": "usuarioId",
              "name": "usuarioId",
              "value": "={{ $json.body.usuario_id }}",
              "type": "string"
            },
            {
              "id": "titulo",
              "name": "titulo",
              "value": "={{ $json.body.recordatorio.titulo }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "prepare-data",
      "name": "Preparar datos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [
        760,
        220
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_BASE_URL }}/internal/reminders/{{$json.recordatorioId}}/sent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Webhook-Secret",
              "value": "={{ $env.BIOMARK_WEBHOOK_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "notify-fcm",
      "name": "Enviar FCM / notificación",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1040,
        220
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.BACKEND_BASE_URL }}/internal/reminders/{{$json.recordatorioId}}/sent",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Webhook-Secret",
              "value": "={{ $env.BIOMARK_WEBHOOK_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "mark-sent",
      "name": "Confirmar envío",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1300,
        220
      ]
    }
  ],
  "connections": {
    "Webhook: recordatorio.creado": {
      "main": [
        [
          {
            "node": "Filtrar evento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filtrar evento": {
      "main": [
        [
          {
            "node": "Preparar datos",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Preparar datos": {
      "main": [
        [
          {
            "node": "Enviar FCM / notificación",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar FCM / notificación": {
      "main": [
        [
          {
            "node": "Confirmar envío",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "versionId": "1"
