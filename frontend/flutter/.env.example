# Configuracion publica de Firebase Web para Flutter.
# No colocar aqui SUPABASE_SERVICE_ROLE_KEY, AI_SERVICE_INTERNAL_KEY ni secretos
# de Firebase Admin. Este archivo se empaqueta como asset en Flutter Web.
BIOMARK_API_URL=https://biomark-api.duckdns.org
# Opcional. Si no se configura, el mapa usa tiles OSM con atribución.
CARTO_API_KEY=
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
FIREBASE_PROJECT_ID=biomark-ai-prod
FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_MESSAGING_SENDER_ID
FIREBASE_WEB_API_KEY=REPLACE_WITH_WEB_API_KEY
FIREBASE_WEB_APP_ID=REPLACE_WITH_WEB_APP_ID
FIREBASE_AUTH_DOMAIN=biomark-ai-prod.firebaseapp.com
FIREBASE_STORAGE_BUCKET=biomark-ai-prod.firebasestorage.app
FIREBASE_VAPID_KEY=REPLACE_WITH_WEB_PUSH_CERTIFICATE_KEY_PAIR
