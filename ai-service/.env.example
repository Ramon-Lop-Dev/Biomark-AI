# Copia este archivo como .env y coloca tus credenciales reales.
# .env NUNCA se sube a git (ver .gitignore).

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_key_real
AI_SERVICE_INTERNAL_KEY=tu_key_real

# --- Opcionales (tienen valores por defecto razonables en config.py) ---
MODEL_ID=BiomarkAI/Biomark-AI-Produccion
PORT=8000
UMBRAL_RELEVANCIA=0.75

ASR_MODEL_ID=openai/whisper-small
TTS_MODEL_ID=facebook/mms-tts-spa

SKIN_MODEL_REPO=Tanishq77/skin-condition-classifier
SKIN_MODEL_FILE=skin_model.keras
THROAT_MODEL_REPO=engrharis/Throat_Image_Classifier
THROAT_EXTRACTOR_FILE=mobilenetv2_feature_extractor.h5
THROAT_KNN_FILE=knn_pharyngitis_model.pkl
